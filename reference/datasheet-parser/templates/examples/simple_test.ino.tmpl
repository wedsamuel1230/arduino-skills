/*
 * {{PART_NAME}} Simple Test Example
 * 
 * This example demonstrates basic initialization and communication
 * with the {{PART_NAME}} device using the generated driver library.
 * 
 * Hardware Connections:
 * ---------------------
 * {{PART_NAME}}     Arduino
 * -----------     -------
 * VCC          -> 3.3V or 5V (check datasheet: {{VCC_RANGE}})
 * GND          -> GND
 * SDA          -> A4 (Uno/Nano) or SDA pin (Mega/Due)
 * SCL          -> A5 (Uno/Nano) or SCL pin (Mega/Due)
 * {{OPTIONAL_PINS}}
 * 
 * I2C Address Configuration:
 * --------------------------
 * Device I2C Address: 0x{{I2C_ADDRESS}} (7-bit)
 * {{ADDRESS_CONFIG_NOTE}}
 * 
 * Notes:
 * ------
 * - Ensure correct voltage level (3.3V or 5V) for your device
 * - Use pull-up resistors on SDA/SCL if not already present (4.7kΩ typical)
 * - Check datasheet for maximum I2C clock frequency
 * 
 * Datasheet: {{DATASHEET_VERSION}}
 * Generated: {{DATE}}
 */

#include <Wire.h>
#include "{{part}}.h"

// Create sensor object with default I2C address
{{Part}} sensor;

void setup() {
    // Initialize Serial communication for debugging
    Serial.begin(115200);
    while (!Serial) {
        delay(10);  // Wait for Serial port to open (needed for native USB)
    }
    
    Serial.println();
    Serial.println("=================================");
    Serial.println("{{PART_NAME}} Simple Test");
    Serial.println("=================================");
    Serial.println();
    
    // Initialize I2C bus
    Wire.begin();
    
    // Optional: Set I2C clock speed (default is usually 100kHz)
    // Wire.setClock(400000);  // 400kHz Fast Mode (if supported by device)
    
    Serial.println("Initializing {{PART_NAME}}...");
    
    // Initialize the sensor
    if (!sensor.begin()) {
        Serial.println("❌ ERROR: Failed to initialize {{PART_NAME}}!");
        Serial.println();
        Serial.println("Troubleshooting checklist:");
        Serial.println("  1. Check wiring connections (SDA, SCL, VCC, GND)");
        Serial.println("  2. Verify I2C address (0x{{I2C_ADDRESS}})");
        Serial.println("  3. Ensure pull-up resistors on SDA/SCL (~4.7kΩ)");
        Serial.println("  4. Check power supply voltage ({{VCC_RANGE}})");
        Serial.println("  5. Run I2C scanner to detect device");
        Serial.println();
        
        // Halt execution
        while (1) {
            delay(1000);
        }
    }
    
    Serial.println("✓ {{PART_NAME}} initialized successfully!");
    Serial.println();
    
    // Read and display device ID (Datasheet p.{{PAGE}})
    uint8_t deviceId = sensor.readId();
    Serial.print("Device ID (WHO_AM_I): 0x");
    Serial.print(deviceId, HEX);
    if (deviceId == {{PART_UPPER}}_DEVICE_ID) {
        Serial.println(" ✓ [Correct]");
    } else {
        Serial.print(" ❌ [Expected: 0x");
        Serial.print({{PART_UPPER}}_DEVICE_ID, HEX);
        Serial.println("]");
    }
    Serial.println();
    
    // Optional: Configure device settings
    // Example: Set operating mode
    // sensor.set{{ConfigParam1}}({{Part}}{{EnumName}}::{{VALUE}});
    
    Serial.println("Starting measurements...");
    Serial.println("=================================");
    Serial.println();
}

void loop() {
    // Read {{DATA_TYPE_1}} value (Datasheet p.{{PAGE}})
    {{DATA_C_TYPE}} {{data_var_1}};
    if (sensor.read{{DataType1}}(&{{data_var_1}})) {
        Serial.print("{{DATA_TYPE_1}}: ");
        Serial.print({{data_var_1}});
        Serial.print(" (raw)");
        
        // Optional: Convert to physical units
        float {{data_var_1}}_{{unit}};
        if (sensor.read{{DataType1}}{{Unit}}(&{{data_var_1}}_{{unit}})) {
            Serial.print(" = ");
            Serial.print({{data_var_1}}_{{unit}}, 2);
            Serial.print(" {{UNIT}}");
        }
        Serial.println();
    } else {
        Serial.println("❌ Failed to read {{DATA_TYPE_1}}");
    }
    
    // Optional: Read all sensor data at once
    /*
    {{Part}}::{{Part}}Data data;
    if (sensor.readAll(&data)) {
        Serial.print("{{DATA_1}}: ");
        Serial.print(data.{{data_field_1}});
        Serial.print(" | {{DATA_2}}: ");
        Serial.print(data.{{data_field_2}});
        Serial.print(" | {{DATA_3}}: ");
        Serial.println(data.{{data_field_3}});
    }
    */
    
    // Optional: Check device status
    /*
    uint8_t status;
    if (sensor.readStatus(&status)) {
        Serial.print("Status: 0b");
        Serial.println(status, BIN);
    }
    */
    
    // Optional: Check if data is ready
    /*
    if (sensor.is{{StatusFlag}}()) {
        Serial.println("✓ Data ready");
    }
    */
    
    // Wait before next reading
    delay(1000);  // 1 second delay
}

