/**
 * BARE-METAL HAL IMPLEMENTATION
 * ==============================
 * 
 * For bare-metal targets, you must provide these I2C functions:
 * 
 * 1. bool i2c_write(uint8_t addr, uint8_t* data, uint8_t len);
 *    - addr: 7-bit I2C device address
 *    - data: Buffer containing bytes to write
 *    - len: Number of bytes to write
 *    - Returns: true if successful, false if NACK or error
 * 
 * 2. bool i2c_read(uint8_t addr, uint8_t* data, uint8_t len);
 *    - addr: 7-bit I2C device address
 *    - data: Buffer to store received bytes
 *    - len: Number of bytes to read
 *    - Returns: true if successful, false if NACK or error
 * 
 * You can implement these functions in your main application file
 * or provide them as weak symbols that can be overridden.
 * 
 * Example (STM32 HAL):
 * --------------------
 * extern I2C_HandleTypeDef hi2c1;
 * 
 * bool i2c_write(uint8_t addr, uint8_t* data, uint8_t len) {
 *     HAL_StatusTypeDef status = HAL_I2C_Master_Transmit(
 *         &hi2c1, addr << 1, data, len, 100
 *     );
 *     return (status == HAL_OK);
 * }
 * 
 * bool i2c_read(uint8_t addr, uint8_t* data, uint8_t len) {
 *     HAL_StatusTypeDef status = HAL_I2C_Master_Receive(
 *         &hi2c1, addr << 1, data, len, 100
 *     );
 *     return (status == HAL_OK);
 * }
 * 
 * Example (ESP-IDF):
 * ------------------
 * bool i2c_write(uint8_t addr, uint8_t* data, uint8_t len) {
 *     i2c_cmd_handle_t cmd = i2c_cmd_link_create();
 *     i2c_master_start(cmd);
 *     i2c_master_write_byte(cmd, (addr << 1) | I2C_MASTER_WRITE, true);
 *     i2c_master_write(cmd, data, len, true);
 *     i2c_master_stop(cmd);
 *     esp_err_t ret = i2c_master_cmd_begin(I2C_NUM_0, cmd, 100/portTICK_PERIOD_MS);
 *     i2c_cmd_link_delete(cmd);
 *     return (ret == ESP_OK);
 * }
 * 
 * bool i2c_read(uint8_t addr, uint8_t* data, uint8_t len) {
 *     i2c_cmd_handle_t cmd = i2c_cmd_link_create();
 *     i2c_master_start(cmd);
 *     i2c_master_write_byte(cmd, (addr << 1) | I2C_MASTER_READ, true);
 *     if (len > 1) {
 *         i2c_master_read(cmd, data, len - 1, I2C_MASTER_ACK);
 *     }
 *     i2c_master_read_byte(cmd, data + len - 1, I2C_MASTER_NACK);
 *     i2c_master_stop(cmd);
 *     esp_err_t ret = i2c_master_cmd_begin(I2C_NUM_0, cmd, 100/portTICK_PERIOD_MS);
 *     i2c_cmd_link_delete(cmd);
 *     return (ret == ESP_OK);
 * }
 */

// Function prototypes (user must implement these)
extern "C" bool i2c_write(uint8_t addr, uint8_t* data, uint8_t len);
extern "C" bool i2c_read(uint8_t addr, uint8_t* data, uint8_t len);

/**
 * @brief Write single byte to register (Bare-metal implementation)
 * 
 * Calls user-provided i2c_write() function.
 * 
 * @param reg Register address
 * @param value Value to write
 * @return true if write successful
 * @return false if I2C error
 */
bool {{Part}}::writeReg(uint8_t reg, uint8_t value) {
    uint8_t data[2] = {reg, value};
    return i2c_write(_addr, data, 2);
}

/**
 * @brief Read single byte from register (Bare-metal implementation)
 * 
 * Performs write-then-read sequence using user-provided I2C functions.
 * 
 * @param reg Register address
 * @param value Pointer to store read value
 * @return true if read successful
 * @return false if I2C error
 */
bool {{Part}}::readReg(uint8_t reg, uint8_t* value) {
    // Write register address
    if (!i2c_write(_addr, &reg, 1)) {
        return false;
    }
    
    // Read data byte
    return i2c_read(_addr, value, 1);
}

/**
 * @brief Read multiple bytes from consecutive registers (Bare-metal implementation)
 * 
 * Performs write-then-read sequence for burst read.
 * Assumes device supports register auto-increment (Datasheet p.{{PAGE}}).
 * 
 * @param reg Starting register address
 * @param buffer Buffer to store read values
 * @param count Number of bytes to read
 * @return true if all bytes read successfully
 * @return false if I2C error
 */
bool {{Part}}::readRegs(uint8_t reg, uint8_t* buffer, uint8_t count) {
    // Write starting register address
    if (!i2c_write(_addr, &reg, 1)) {
        return false;
    }
    
    // Read multiple bytes
    return i2c_read(_addr, buffer, count);
}

