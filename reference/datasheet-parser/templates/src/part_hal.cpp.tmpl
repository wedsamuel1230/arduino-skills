/**
 * @brief Write single byte to register (Arduino implementation)
 * 
 * Uses Arduino Wire library for I2C communication.
 * Wire must be initialized (Wire.begin()) before calling this function.
 * 
 * @param reg Register address
 * @param value Value to write
 * @return true if write successful (ACK received)
 * @return false if NACK or other I2C error
 */
bool {{Part}}::writeReg(uint8_t reg, uint8_t value) {
    Wire.beginTransmission(_addr);
    Wire.write(reg);
    Wire.write(value);
    
    // endTransmission returns:
    // 0: success
    // 1: data too long
    // 2: NACK on address
    // 3: NACK on data
    // 4: other error
    uint8_t result = Wire.endTransmission();
    return (result == 0);
}

/**
 * @brief Read single byte from register (Arduino implementation)
 * 
 * Uses Arduino Wire library for I2C communication.
 * Performs write-then-read sequence (register address, then data).
 * 
 * @param reg Register address
 * @param value Pointer to store read value
 * @return true if read successful
 * @return false if I2C error
 */
bool {{Part}}::readReg(uint8_t reg, uint8_t* value) {
    // Write register address
    Wire.beginTransmission(_addr);
    Wire.write(reg);
    
    // Use repeated start (false = don't release bus)
    if (Wire.endTransmission(false) != 0) {
        return false;  // Failed to write register address
    }
    
    // Request 1 byte from device
    uint8_t bytesReceived = Wire.requestFrom(_addr, (uint8_t)1);
    if (bytesReceived != 1) {
        return false;  // Device didn't respond
    }
    
    // Read byte if available
    if (Wire.available()) {
        *value = Wire.read();
        return true;
    }
    
    return false;
}

/**
 * @brief Read multiple bytes from consecutive registers (Arduino implementation)
 * 
 * Uses Arduino Wire library for efficient burst read.
 * Most devices support auto-increment of register address during burst reads.
 * 
 * Datasheet p.{{PAGE}}: {{AUTO_INCREMENT_NOTE}}
 * 
 * @param reg Starting register address
 * @param buffer Buffer to store read values
 * @param count Number of bytes to read
 * @return true if all bytes read successfully
 * @return false if I2C error or incomplete read
 */
bool {{Part}}::readRegs(uint8_t reg, uint8_t* buffer, uint8_t count) {
    // Write starting register address
    Wire.beginTransmission(_addr);
    Wire.write(reg);
    
    // Use repeated start to keep bus control
    if (Wire.endTransmission(false) != 0) {
        return false;  // Failed to write register address
    }
    
    // Request multiple bytes from device
    uint8_t bytesReceived = Wire.requestFrom(_addr, count);
    if (bytesReceived != count) {
        return false;  // Incomplete read
    }
    
    // Read all bytes into buffer
    uint8_t i = 0;
    while (Wire.available() && i < count) {
        buffer[i++] = Wire.read();
    }
    
    return (i == count);
}

