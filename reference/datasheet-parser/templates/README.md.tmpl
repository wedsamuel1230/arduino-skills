## 🚀 Quick Start

### Minimal Example

```cpp
#include <Wire.h>
#include "{{part}}.h"

{{Part}} sensor;  // Create sensor object

void setup() {
    Serial.begin(115200);
    Wire.begin();
    
    if (!sensor.begin()) {
        Serial.println("Sensor not found!");
        while(1);
    }
    
    Serial.println("Sensor initialized!");
}

void loop() {
    {{DATA_C_TYPE}} value;
    if (sensor.read{{DataType1}}(&value)) {
        Serial.println(value);
    }
    delay(1000);
}
```

See [`examples/simple_test.ino`](examples/simple_test.ino) for complete example.

